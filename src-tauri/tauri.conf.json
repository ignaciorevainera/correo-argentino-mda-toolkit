{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "correo-argentino-mda-toolkit",
  "version": "0.1.0",
  "identifier": "com.correoargentino.mdatoolkit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Correo Argentino MDA Toolkit",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/tu-usuario/correo-argentino-mda-toolkit/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwNDM4ODFCNDUwQTlDMzUKUldRMW5BcEZHNGhEd01WTzNINndiUzBYVGliNENicklPVWo1YVBraTZtREZ0M1h3c0VsTC84VGoK"
    }
  }
}
